# App
APP_NAME=KuroFunnels
SECRET_KEY=kuro-dev-secret-key-change-in-production-32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database — SQLite for local dev (no PostgreSQL needed)
DATABASE_URL=sqlite:///./kurofunnels.db

# Redis — leave as-is; backend degrades gracefully if Redis not running
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Email tracking
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Environment
ENVIRONMENT=development
